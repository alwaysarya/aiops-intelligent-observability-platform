# Application
APP_NAME=alert-service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8002

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ANOMALIES=aiops.anomalies
KAFKA_CONSUMER_GROUP=alert-service

# Redis (dedup)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
DEDUP_WINDOW_SECONDS=300

# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts

# Email
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@aiops.local
EMAIL_TO=admin@aiops.local

# Webhook
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# Alert thresholds
MIN_SEVERITY_TO_ALERT=medium

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=alert-service

# Metrics
METRICS_PORT=9090
