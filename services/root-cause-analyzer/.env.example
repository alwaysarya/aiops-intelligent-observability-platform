# Application
APP_NAME=root-cause-analyzer
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8003

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ANOMALIES=aiops.anomalies
KAFKA_TOPIC_ROOT_CAUSES=aiops.root_causes
KAFKA_CONSUMER_GROUP=root-cause-analyzer

# Elasticsearch
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_INDEX_LOGS=aiops-logs

# Analysis
CORRELATION_WINDOW_SECONDS=300
MAX_DEPENDENCIES=10
CAUSALITY_THRESHOLD=0.7

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=root-cause-analyzer

# Metrics
METRICS_PORT=9090
