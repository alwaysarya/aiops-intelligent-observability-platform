                      <div className="min-w-0">
                        <p className="truncate text-sm font-medium text-zinc-100">
                          {service.name}
                        </p>
                        <p className="mt-1 text-xs text-zinc-500">
                          {service.detail}
                        </p>
                      </div>
                    </div>

                    <div className="ml-auto flex items-center gap-4 sm:gap-6">
                      <div className="hidden text-right sm:block">
                        <p className="text-sm font-medium text-zinc-200">
                          {service.uptime}
                        </p>
                        <p className="mt-1 text-[11px] text-zinc-500">
                          Availability
                        </p>
                      </div>

                      <StatusPill status={service.status} />
                    </div>
                  </motion.div>
                );
              })}
            </div>

            {/* Recent deployments */}
            <div className="mt-9">
              <SectionHeading
                eyebrow="Delivery"
                title="Recent deployments"
                description="A quick look at recent release activity."
                action={
                  <span className="inline-flex items-center gap-1.5 text-xs text-zinc-500">
                    <GitBranch size={14} />
                    CI / CD
                  </span>
                }
              />

              <div className="mt-5 overflow-x-auto rounded-2xl border border-white/[0.07] bg-[#111115]">
                <table className="w-full min-w-[540px] text-left">
                  <thead>
                    <tr className="border-b border-white/[0.07] text-[11px] uppercase tracking-wider text-zinc-500">
                      <th className="px-5 py-3.5 font-medium">Release</th>
                      <th className="px-4 py-3.5 font-medium">
                        Environment
                      </th>
                      <th className="px-4 py-3.5 font-medium">Status</th>
                      <th className="px-5 py-3.5 font-medium">Time</th>
                    </tr>
                  </thead>

                  <tbody>
                    {deployments.map((deployment) => (
                      <tr
                        key={deployment.version}
                        className="border-b border-white/[0.045] last:border-0 transition hover:bg-white/[0.025]"
                      >
                        <td className="px-5 py-4">
                          <p className="text-sm font-medium text-zinc-200">
                            {deployment.version}
                          </p>
                          <p className="mt-1 text-xs text-zinc-500">
                            {deployment.branch}
                          </p>
                        </td>

                        <td className="px-4 py-4 text-sm text-zinc-400">
                          {deployment.environment}
                        </td>

                        <td className="px-4 py-4">
                          <StatusPill status={deployment.status} />
                        </td>

                        <td className="px-5 py-4 text-xs text-zinc-500">
                          {deployment.time}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          {/* Right column */}
          <aside className="min-w-0 space-y-6">
            <section>
              <SectionHeading
                eyebrow="Live feed"
                title="Recent activity"
                description="Latest events across your workspace."
                action={
                  <span className="flex items-center gap-1.5 text-[11px] text-zinc-500">
                    <Clock3 size={13} />
                    Activity
                  </span>
                }
              />

              <div className="mt-5 rounded-2xl border border-white/[0.07] bg-[#111115] p-4 sm:p-5">
                <label className="relative block">
                  <span className="sr-only">Filter activity</span>

                  <select
                    value={activityFilter}
                    onChange={(event) =>
                      setActivityFilter(event.target.value)
                    }
                    className="w-full appearance-none rounded-lg border border-white/[0.07] bg-[#17171C] px-3 py-2.5 pr-9 text-xs text-zinc-300 outline-none focus:border-blue-500/60"
                  >
                    <option>All activity</option>
                    <option>Deployments</option>
                    <option>Alerts</option>
                  </select>

                  <ChevronDown
                    size={13}
                    className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-500"
                  />
                </label>

                <div className="mt-5">
                  {filteredActivities.length > 0 ? (
                    filteredActivities.map((item, index) => {
                      const Icon =
                        item.type === "warning"
                          ? AlertCircle
                          : item.type === "success"
                            ? CheckCircle2
                            : Terminal;

                      const iconColor =
                        item.type === "warning"
                          ? "text-orange-300 bg-orange-400/10"
                          : item.type === "success"
                            ? "text-emerald-300 bg-emerald-400/10"
                            : "text-blue-300 bg-blue-400/10";

                      return (
                        <div
                          key={item.title}
                          className={`relative flex gap-3 ${
                            index !== filteredActivities.length - 1
                              ? "pb-5"
                              : "pb-1"
                          }`}
                        >
                          {index !== filteredActivities.length - 1 && (
                            <span className="absolute bottom-0 left-[15px] top-8 w-px bg-white/[0.07]" />
                          )}

                          <div
                            className={`relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${iconColor}`}
                          >
                            <Icon size={15} />
                          </div>

                          <div className="min-w-0 flex-1 pt-0.5">
                            <p className="text-[13px] font-medium leading-5 text-zinc-200">
                              {item.title}
                            </p>
                            <p className="mt-1 text-xs leading-5 text-zinc-500">
                              {item.detail}
                            </p>
                            <p className="mt-2 text-[10px] text-zinc-600">
                              {item.time}
                            </p>
                          </div>
                        </div>
                      );
                    })
                  ) : (
                    <p className="py-6 text-center text-sm text-zinc-500">
                      No matching activity.
                    </p>
                  )}
                </div>
              </div>
            </section>

            {/* System status */}
            <section className="rounded-2xl border border-white/[0.07] bg-[#111115] p-5 sm:p-6">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-semibold text-white">
                    System status
                  </p>
                  <p className="mt-1 text-xs text-zinc-500">
                    Overall infrastructure health
                  </p>
                </div>

                <ShieldCheck size={21} className="text-emerald-300" />
              </div>

              <div className="mt-6 flex items-center gap-3">
                <div className="flex h-11 w-11 items-center justify-center rounded-full border border-emerald-400/15 bg-emerald-400/[0.07]">
                  <CheckCircle2 size={21} className="text-emerald-300" />
                </div>

                <div>
                  <p className="text-sm font-medium text-emerald-300">
                    Core systems operational
                  </p>
                  <p className="mt-1 text-xs text-zinc-500">
                    One service is being monitored.
                  </p>
                </div>
              </div>

              <div className="mt-6 space-y-4">
                {[
                  {
                    label: "API availability",
                    value: 99,
                    display: "99%",
                  },
                  {
                    label: "Build success rate",
                    value: 96,
                    display: "96%",
                  },
                  {
                    label: "Resource capacity",
                    value: 72,
                    display: "72%",
                  },
                ].map((item) => (
                  <div key={item.label}>
                    <div className="mb-2 flex items-center justify-between gap-3 text-xs">
                      <span className="text-zinc-400">{item.label}</span>
                      <span className="font-medium tabular-nums text-zinc-200">
                        {item.display}
                      </span>
                    </div>

                    <div className="h-1.5 overflow-hidden rounded-full bg-white/[0.07]">
                      <motion.div
                        initial={{ width: 0 }}
                        animate={{ width: `${item.value}%` }}
                        transition={{ duration: 0.8, ease: "easeOut" }}
                        className="h-full rounded-full bg-zinc-300"
                      />
                    </div>
                  </div>
                ))}
              </div>

              <p className="mt-5 border-t border-white/[0.06] pt-4 text-[11px] leading-5 text-zinc-600">
                Example monitoring values. Connect live telemetry to display
                actual system health.
              </p>
            </section>

            {/* Developer workspace */}
            <section className="rounded-2xl border border-white/[0.07] bg-[#111115] p-5">
              <div className="flex items-center gap-3">
                <div className="rounded-xl bg-white/[0.05] p-2.5 text-zinc-300">
                  <Terminal size={18} />
                </div>

                <div>
                  <p className="text-sm font-semibold text-zinc-100">
                    Developer workspace
                  </p>
                  <p className="mt-1 text-xs text-zinc-500">
                    Tools and project resources
                  </p>
                </div>
              </div>

              <div className="mt-4 divide-y divide-white/[0.06]">
                {[
                  {
                    label: "Deployment history",
                    icon: GitBranch,
                  },
                  {
                    label: "Infrastructure resources",
                    icon: Server,
                  },
                  {
                    label: "System diagnostics",
                    icon: Activity,
                  },
                ].map((item) => {
                  const Icon = item.icon;

                  return (
                    <div
                      key={item.label}
                      className="flex w-full items-center justify-between gap-3 py-3 text-xs text-zinc-400"
                    >
                      <span className="flex items-center gap-2.5">
                        <Icon size={15} />
                        {item.label}
                      </span>

                      <ArrowRight size={14} />
                    </div>
                  );
                })}
              </div>
            </section>
          </aside>
        </div>

        <footer className="mt-10 flex flex-col gap-2 border-t border-white/[0.06] pt-5 text-[11px] text-zinc-600 sm:flex-row sm:items-center sm:justify-between">
          <span>Workspace overview</span>

          <span className="flex items-center gap-1.5">
            <span className="h-1.5 w-1.5 rounded-full bg-emerald-400" />
            Interface ready
          </span>
        </footer>
      </div>
    </main>
  );
}
