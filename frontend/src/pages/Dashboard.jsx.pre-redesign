import { useState } from 'react'
import { Link } from 'react-router-dom'
import { motion } from 'framer-motion'
import {
  Activity, ArrowRight, ArrowUpRight, Bell,
  CheckCircle2, ChevronRight, Clock3, Cpu,
  Database, ExternalLink, GitBranch, Globe2,
  HardDrive, Layers3, Network, Radio,
  Search, Server, ShieldCheck, Terminal,
  TrendingUp, Zap, AlertTriangle
} from 'lucide-react'

const metrics = [
  { label: 'Total requests', value: '1.28M', change: '+12.8%', icon: Activity, color: '#8B8CF8' },
  { label: 'Avg. latency', value: '42ms', change: '-8.2%', icon: Clock3, color: '#67D8C3' },
  { label: 'Error rate', value: '0.12%', change: '-0.04%', icon: AlertTriangle, color: '#F3B86C' },
  { label: 'Availability', value: '99.98%', change: '+0.02%', icon: ShieldCheck, color: '#67D8C3' }
]

const services = [
  { name: 'API Gateway', detail: 'Edge · Production', latency: '24ms', health: 'Healthy' },
  { name: 'Authentication', detail: 'Identity · Production', latency: '38ms', health: 'Healthy' },
  { name: 'Log Processor', detail: 'Pipeline · Production', latency: '112ms', health: 'Warning' },
  { name: 'Metrics Engine', detail: 'Telemetry · Production', latency: '31ms', health: 'Healthy' }
]

const activity = [
  { title: 'Elevated ingestion latency', detail: 'Log Processor · Warning', time: '12m', color: '#F3B86C' },
  { title: 'API response time stabilized', detail: 'API Gateway · Recovery', time: '38m', color: '#67D8C3' },
  { title: 'Anomaly assessment completed', detail: 'Metrics Engine · Analysis', time: '1h', color: '#8B8CF8' },
  { title: 'Infrastructure health check', detail: 'System · Completed', time: '2h', color: '#67D8C3' }
]

const chartPoints = [32, 38, 34, 44, 41, 53, 48, 46, 59, 52, 63, 58, 54, 66, 61, 72, 64, 68, 60, 75, 69, 77, 71, 81, 73, 79, 70, 84, 78, 87, 82, 91, 85, 88, 79, 92, 86, 94, 83, 89]

const chartPath = chartPoints.map((v, i) =>
  `${i === 0 ? 'M' : 'L'} ${(i / (chartPoints.length - 1)) * 1000} ${180 - v * 1.5}`
).join(' ')

const panel = 'rounded-xl border border-white/[0.075] bg-[#111115] overflow-hidden'
const muted = 'text-[#858590]'
const iconBox = 'flex h-9 w-9 items-center justify-center rounded-lg border border-white/[0.07] bg-white/[0.035]'

function SectionTitle({ title, subtitle, action, to }) {
  return (
    <div className="flex flex-wrap items-center justify-between gap-3 px-5 py-4 border-b border-white/[0.065]">
      <div>
        <h2 className="text-[13px] font-semibold text-[#E9E9ED]">{title}</h2>
        {subtitle && <p className="mt-1 text-[11px] text-[#777782]">{subtitle}</p>}
      </div>
      {action && to && (
        <Link to={to} className="flex items-center gap-1 text-[11px] text-[#A0A0AD] hover:text-white transition-colors">
          {action} <ArrowUpRight size={13}/>
        </Link>
      )}
    </div>
  )
}

function Dashboard() {
  const [period, setPeriod] = useState('24 hours')
  const [query, setQuery] = useState('')
  const visibleServices = services.filter(s =>
    `${s.name} ${s.detail}`.toLowerCase().includes(query.toLowerCase())
  )

  return (
    <div className="min-h-screen w-full bg-[#0B0B0E] text-[#E9E9ED] font-sans antialiased">
      <div className="mx-auto max-w-[1520px] px-5 py-7 md:px-9 lg:px-12">

        {/* BREADCRUMB */}
        <div className="mb-8 flex flex-wrap items-center justify-between gap-4">
          <div className="flex items-center gap-2 text-[12px] text-[#777782]">
            <Layers3 size={15} className="text-[#8B8CF8]"/>
            <span>Workspace</span>
            <ChevronRight size={13}/>
            <span className="text-[#D5D5DB]">Overview</span>
          </div>
          <div className="flex items-center gap-2">
            <span className="flex items-center gap-2 rounded-md border border-white/[0.08] bg-[#141418] px-3 py-1.5 text-[11px] text-[#B7B7C1]">
              <span className="h-1.5 w-1.5 rounded-full bg-[#67D8C3]"/>
              Production
            </span>
            <span className="rounded-md border border-white/[0.08] bg-[#141418] px-3 py-1.5 text-[11px] text-[#92929E]">
              Demo data
            </span>
          </div>
        </div>

        {/* PAGE HEADER */}
        <div className="mb-8 flex flex-col justify-between gap-5 md:flex-row md:items-end">
          <div>
            <div className="mb-3 flex items-center gap-2 text-[11px] font-medium tracking-[0.13em] text-[#8989E9] uppercase">
              <Radio size={13}/> Intelligence workspace
            </div>
            <h1 className="text-[32px] font-semibold tracking-[-0.045em] md:text-[40px]">
              Overview
            </h1>
            <p className="mt-2 max-w-xl text-[13px] leading-6 text-[#858590]">
              A unified view of infrastructure health, service performance and operational intelligence.
            </p>
          </div>
          <div className="flex items-center gap-2">
            <select
              value={period}
              onChange={e => setPeriod(e.target.value)}
              aria-label="Display period"
              className="rounded-lg border border-white/[0.09] bg-[#16161B] px-3 py-2.5 text-[12px] text-[#D1D1D8] outline-none focus:border-[#8B8CF8]"
            >
              <option>24 hours</option>
              <option>7 days</option>
              <option>30 days</option>
            </select>
            <Link to="/logs" className="flex items-center gap-2 rounded-lg bg-[#E9E9ED] px-4 py-2.5 text-[12px] font-semibold text-[#101014] hover:bg-white transition-colors">
              Explore logs <ArrowUpRight size={14}/>
            </Link>
          </div>
        </div>

        {/* METRICS */}
        <div className="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
          {metrics.map((m, i) => (
            <motion.div
              key={m.label}
              initial={{ opacity: 0, y: 12 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: i * 0.06, duration: 0.35 }}
              className={`${panel} p-5 transition-colors hover:border-white/[0.15]`}
            >
              <div className="mb-6 flex items-center justify-between">
                <span className="text-[12px] text-[#93939F]">{m.label}</span>
                <m.icon size={16} style={{ color: m.color }}/>
              </div>
              <div className="flex flex-wrap items-end justify-between gap-2">
                <span className="text-[29px] font-semibold tracking-[-0.055em]">{m.value}</span>
                <span className="rounded-md bg-white/[0.04] px-2 py-1 text-[11px] text-[#A2A2B0]">{m.change}</span>
              </div>
              <div className="mt-4 h-[2px] w-full rounded-full bg-white/[0.06]">
                <div className="h-full w-[64%] rounded-full" style={{ background: m.color, opacity: 0.65 }}/>
              </div>
            </motion.div>
          ))}
        </div>

        {/* MAIN BENTO */}
        <div className="mb-4 grid grid-cols-1 gap-4 xl:grid-cols-3">

          <div className={`${panel} xl:col-span-2`}>
            <SectionTitle title="Request throughput" subtitle={`Illustrative performance trend · ${period}`} action="View logs" to="/logs"/>
            <div className="px-5 pb-5 pt-6">
              <div className="mb-6 flex items-end gap-3">
                <span className="text-[34px] font-semibold tracking-[-0.05em]">14,280</span>
                <span className="mb-1.5 text-[12px] text-[#858590]">requests / min</span>
                <span className="mb-1.5 ml-auto flex items-center gap-1 text-[11px] text-[#67D8C3]">
                  <TrendingUp size={13}/> +8.4%
                </span>
              </div>
              <div className="relative h-[220px] overflow-hidden">
                <div className="absolute inset-0 flex flex-col justify-between">
                  {[0,1,2,3,4].map(x => <div key={x} className="border-t border-dashed border-white/[0.06]"/>)}
                </div>
                <svg viewBox="0 0 1000 200" preserveAspectRatio="none" className="relative h-full w-full overflow-visible">
                  <defs>
                    <linearGradient id="linearDashArea" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stopColor="#8B8CF8" stopOpacity=".25"/>
                      <stop offset="100%" stopColor="#8B8CF8" stopOpacity="0"/>
                    </linearGradient>
                  </defs>
                  <path d={`${chartPath} L 1000 200 L 0 200 Z`} fill="url(#linearDashArea)"/>
                  <path d={chartPath} fill="none" stroke="#8B8CF8" strokeWidth="2.5" vectorEffect="non-scaling-stroke" strokeLinejoin="round"/>
                </svg>
              </div>
              <div className="mt-4 flex justify-between text-[10px] text-[#666672]">
                <span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>23:59</span>
              </div>
            </div>
          </div>

          <div className={panel}>
            <SectionTitle title="System health" subtitle="Infrastructure summary" action="Service map" to="/service-map"/>
            <div className="flex flex-col items-center px-5 py-7">
              <div className="relative flex h-[170px] w-[170px] items-center justify-center">
                <div className="absolute inset-0 rounded-full border-[11px] border-[#25252D]"/>
                <div className="absolute inset-0 rounded-full border-[11px] border-[#67D8C3] border-l-transparent rotate-[-35deg]"/>
                <div className="text-center">
                  <div className="text-[36px] font-semibold tracking-[-0.06em]">98.6</div>
                  <div className="text-[11px] text-[#858590]">Health score</div>
                </div>
              </div>
              <div className="mt-7 w-full space-y-4">
                {[
                  ['Operational', '18 services', '#67D8C3'],
                  ['Degraded', '2 services', '#F3B86C'],
                  ['Critical', '0 services', '#F07979']
                ].map(([name,value,color]) => (
                  <div key={name} className="flex items-center justify-between text-[12px]">
                    <span className="flex items-center gap-2 text-[#9B9BA7]">
                      <span className="h-2 w-2 rounded-full" style={{background:color}}/>{name}
                    </span>
                    <span className="text-[#D4D4DC]">{value}</span>
                  </div>
                ))}
              </div>
              <p className="mt-5 text-center text-[10px] text-[#676773]">Illustrative service health data</p>
            </div>
          </div>
        </div>

        {/* SERVICES AND ACTIVITY */}
        <div className="mb-4 grid grid-cols-1 gap-4 xl:grid-cols-5">
          <div className={`${panel} xl:col-span-3`}>
            <SectionTitle title="Service performance" subtitle="Latency and service status" action="View topology" to="/service-map"/>
            <div className="border-b border-white/[0.06] px-5 py-3">
              <div className="flex max-w-[300px] items-center gap-2 rounded-md border border-white/[0.08] bg-[#17171C] px-3 py-2">
                <Search size={13} className="text-[#777782]"/>
                <input
                  value={query}
                  onChange={e => setQuery(e.target.value)}
                  placeholder="Filter services..."
                  className="w-full bg-transparent text-[11px] text-white outline-none placeholder:text-[#656570]"
                />
              </div>
            </div>
            <div className="overflow-x-auto">
              <table className="w-full min-w-[430px] text-left">
                <thead className="text-[10px] text-[#6F6F7B]">
                  <tr className="border-b border-white/[0.06]">
                    <th className="px-5 py-3 font-medium">SERVICE</th>
                    <th className="px-3 py-3 font-medium">LATENCY</th>
                    <th className="px-5 py-3 font-medium">STATUS</th>
                  </tr>
                </thead>
                <tbody>
                  {visibleServices.map(s => (
                    <tr key={s.name} className="border-b border-white/[0.045] last:border-0 hover:bg-white/[0.025]">
                      <td className="px-5 py-4">
                        <div className="flex items-center gap-3">
                          <div className={iconBox}><Server size={15} className="text-[#9999D9]"/></div>
                          <div>
                            <div className="text-[12px] font-medium">{s.name}</div>
                            <div className="mt-1 text-[10px] text-[#70707B]">{s.detail}</div>
                          </div>
                        </div>
                      </td>
                      <td className="px-3 py-4 font-mono text-[11px] text-[#B6B6C1]">{s.latency}</td>
                      <td className="px-5 py-4">
                        <span className={`inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-[10px] ${
                          s.health === 'Healthy'
                          ? 'bg-[#67D8C3]/[0.08] text-[#67D8C3]'
                          : 'bg-[#F3B86C]/[0.08] text-[#F3B86C]'
                        }`}>
                          <span className="h-1.5 w-1.5 rounded-full bg-current"/>{s.health}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
              {!visibleServices.length && <p className="p-5 text-[12px] text-[#858590]">No matching services.</p>}
            </div>
          </div>

          <div className={`${panel} xl:col-span-2`}>
            <SectionTitle title="Recent activity" subtitle="Operational event timeline" action="View alerts" to="/alerts"/>
            <div className="px-5 py-3">
              {activity.map((item, i) => (
                <div key={i} className="relative flex gap-3 py-4">
                  {i !== activity.length - 1 && <div className="absolute left-[5px] top-8 h-[calc(100%-10px)] w-px bg-white/[0.08]"/>}
                  <div className="relative mt-1 h-[11px] w-[11px] shrink-0 rounded-full border-[3px] border-[#111115]" style={{background:item.color}}/>
                  <div className="min-w-0 flex-1">
                    <p className="text-[12px] font-medium text-[#DCDCE3]">{item.title}</p>
                    <p className="mt-1 text-[11px] text-[#777782]">{item.detail}</p>
                  </div>
                  <span className="shrink-0 text-[10px] text-[#656570]">{item.time}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* BOTTOM */}
        <div className="grid grid-cols-1 gap-4 md:grid-cols-3">
          {[
            { icon: Terminal, title: 'Log explorer', desc: 'Investigate and filter application events', path: '/logs', accent: '#8B8CF8' },
            { icon: GitBranch, title: 'Root cause analysis', desc: 'Explore dependencies and incidents', path: '/root-cause', accent: '#67D8C3' },
            { icon: Bell, title: 'Alert center', desc: 'Review operational signals', path: '/alerts', accent: '#F3B86C' }
          ].map(item => (
            <Link key={item.title} to={item.path} className={`${panel} group flex items-start gap-4 p-5 transition-all hover:border-white/[0.18] hover:bg-[#17171C]`}>
              <div className={iconBox}><item.icon size={17} style={{color:item.accent}}/></div>
              <div className="min-w-0 flex-1">
                <h3 className="text-[12px] font-semibold">{item.title}</h3>
                <p className="mt-1 text-[11px] leading-5 text-[#777782]">{item.desc}</p>
              </div>
              <ArrowUpRight size={15} className="text-[#676773] transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-white"/>
            </Link>
          ))}
        </div>

        <div className="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-white/[0.06] pt-5 text-[10px] text-[#62626D]">
          <span>AIOps / Intelligent Observability</span>
          <span>Preview metrics · Connect data sources for live observability</span>
        </div>
      </div>
    </div>
  )
}

export default Dashboard
