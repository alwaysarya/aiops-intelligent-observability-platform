                    <td className="px-3 py-4 font-mono text-xs text-[#B6C0BC]">{s.latency}</td>
                    <td className="px-5 py-4"><span className="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px]" style={{color:s.color,borderColor:`${s.color}30`,background:`${s.color}0D`}}><span className="h-1.5 w-1.5 rounded-full bg-current"/>{s.status}</span></td>
                  </tr>)}</tbody>
                </table>
                {filtered.length===0&&<p className="p-6 text-xs text-[#89928E]">No matching services.</p>}
              </div>
              <p className="border-t border-white/[0.05] px-5 py-3 text-[9px] text-[#626B68]">Sample service data · Replace with your existing API data source.</p>
            </div>

            <div className={`${panel} xl:col-span-2`}>
              <div className="flex items-center justify-between border-b border-white/[0.07] px-5 py-4"><div><h3 className="text-sm font-medium">Recent activity</h3><p className="mt-1 text-[10px] text-[#747D7B]">Operational event timeline</p></div><span className="rounded-md border border-white/[0.08] px-2 py-1 text-[9px] text-[#8C9692]">ACTIVITY</span></div>
              <div className="p-5">
                {events.map((e,i)=><div key={e.title} className="relative flex gap-3 pb-6 last:pb-0">
                  {i!==events.length-1&&<div className="absolute bottom-0 left-[5px] top-4 w-px bg-white/[0.09]"/>}
                  <span className="relative mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full border-2 border-[#101316]" style={{background:e.color,boxShadow:`0 0 12px ${e.color}55`}}/>
                  <div className="min-w-0 flex-1"><p className="text-xs font-medium text-[#DDE4E0]">{e.title}</p><p className="mt-1.5 text-[10px] text-[#7C8682]">{e.detail}</p></div><span className="shrink-0 pt-0.5 text-[9px] text-[#69716F]">{e.time}</span>
                </div>)}
              </div>
              <Link to="/alerts" className="mx-5 mb-5 flex items-center justify-center gap-2 rounded-lg border border-white/[0.08] py-2.5 text-xs text-[#C3CCC8] transition-colors hover:border-[#70E9CA]/30 hover:text-[#70E9CA]">Open alert center <ArrowUpRight size={13}/></Link>
            </div>
          </div>
        </motion.section>

        {/* QUICK ACCESS */}
        <motion.section
          initial={{ opacity: 0, y: 22 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, amount: 0.12 }}
          transition={{ duration: 0.65, ease: 'easeOut' }}
          className="mb-8">
          <div className="mb-4"><Heading eyebrow="Quick access" title="Go deeper" note="Move from overview to investigation in one step."/></div>
          <div className="grid grid-cols-1 gap-3 md:grid-cols-3">
            {[
              {icon:Terminal,title:'Log explorer',desc:'Investigate events and application signals.',path:'/logs',tag:'LOGS',color:'#70E9CA'},
              {icon:GitBranch,title:'Root cause analysis',desc:'Follow dependencies and investigate incidents.',path:'/root-cause',tag:'ANALYSIS',color:'#A991FF'},
              {icon:Bell,title:'Alert center',desc:'Review warnings and operational events.',path:'/alerts',tag:'ALERTS',color:'#F7B96D'},
            ].map((item,i)=><motion.div key={item.title} whileHover={{y:-3}} transition={{duration:.2}}><Link to={item.path} className={`${panel} group flex h-full items-start gap-4 p-5 transition-all duration-300 hover:border-white/[0.17] hover:bg-[#14191A]`}>
              <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/[0.08] bg-white/[0.025] transition-all group-hover:scale-105" style={{color:item.color}}><item.icon size={18}/></span>
              <div className="min-w-0 flex-1"><div className="mb-2 flex items-center gap-2"><span className="text-[9px] tracking-[.15em]" style={{color:item.color}}>{item.tag}</span><span className="h-px flex-1 bg-white/[0.07]"/></div><h3 className="text-sm font-medium">{item.title}</h3><p className="mt-2 text-xs leading-5 text-[#818B87]">{item.desc}</p></div>
              <ArrowUpRight size={15} className="shrink-0 text-[#626C68] transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-[#70E9CA]"/>
            </Link></motion.div>)}
          </div>
        </motion.section>

        <footer className="flex flex-wrap items-center justify-between gap-3 border-t border-white/[0.07] py-5 text-[10px] text-[#626B68]">
          <span className="flex items-center gap-2"><Command size={12}/> AIOps Intelligence Workspace</span>
          <span className="flex items-center gap-2"><span className="h-1.5 w-1.5 rounded-full bg-[#70E9CA]"/> UI preview · Metrics shown above are illustrative</span>
        </footer>
      </div>
    </main>
  )
}

export default Dashboard
