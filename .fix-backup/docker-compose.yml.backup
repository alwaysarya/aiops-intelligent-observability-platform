networks:
  aiops-network:
    name: log-ingestion-service_aiops-network
    external: true

services:
  api-gateway:
    build: ./services/api-gateway
    container_name: aiops-api-gateway
    ports:
      - "8080:8080"
    environment:
      - ENVIRONMENT=development
    networks:
      - aiops-network
    restart: unless-stopped

  log-ingestion-service:
    build: ./services/log-ingestion-service
    container_name: aiops-log-ingestion
    ports:
      - "8000:8000"
    networks:
      - aiops-network
    restart: unless-stopped
